<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>io.github.lamspace</groupId><artifactId>meili-orm-it</artifactId><version>1.0-SNAPSHOT</version></parent>
    <artifactId>meili-orm-it-boot4</artifactId>
    <name>meili-orm-it-boot4</name>
    <description>兼容矩阵 Boot 4.0.3 代：starter 装配与 Long 主键 CRUD 真机往返及版本哨兵。</description>
    <dependencyManagement>
        <dependencies>
            <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-bom</artifactId><version>${testcontainers.version}</version><type>pom</type><scope>import</scope></dependency>
            <!-- 子模块首位 import 覆盖继承的 3.5.16 基线：本模块 classpath 恒为 Boot 4.0.3 代。 -->
            <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-dependencies</artifactId><version>4.0.3</version><type>pom</type><scope>import</scope></dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency><groupId>io.github.lamspace</groupId><artifactId>spring-boot-starter-meili-orm</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.github.lamspace</groupId><artifactId>meili-orm-core</artifactId><type>test-jar</type><scope>test</scope></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <!-- 派生查询语法/属性桥常哨兵源所用 commons 域面（本模块解析为 Boot 4 代 commons）。 -->
        <dependency><groupId>org.springframework.data</groupId><artifactId>spring-data-commons</artifactId><scope>test</scope></dependency>
        <!-- 矩阵仓库用例：opt-in 坐标显式引入（starter 聚合面零变化）。 -->
        <dependency><groupId>io.github.lamspace</groupId><artifactId>meili-orm-repository</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    </dependencies>
    <build><plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
            <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions></plugin>
        <!-- test-jar 供 opt-in 矩阵模块复用 ITBook/ItApp（Jackson3 接管验证）。 -->
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId>
            <executions><execution><goals><goal>test-jar</goal></goals></execution></executions></plugin>
    </plugins></build>
</project>
